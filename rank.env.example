# Copy locally and set each rank's addresses and absolute paths.
# Keep private host files out of version control.
IMAGE_ID=sha256:REPLACE_WITH_VERIFIED_BUILT_IMAGE_ID
MODEL_PATH=/srv/models/altar-1/5d591cd98958e4e7e429517887e80ca3bb7ce2c4
CACHE_PATH=/srv/altar-cache
API_KEY_FILE=/home/USER/.config/altar/api.key
HOST_IP=REPLACE_WITH_THIS_HOST_MANAGEMENT_IP
MASTER_ADDR=REPLACE_WITH_RANK_ZERO_MANAGEMENT_IP
SOCKET_IFNAME=enP7s7
NCCL_IB_HCA='=rocep1s0f0:1,rocep1s0f1:1,roceP2p1s0f0:1,roceP2p1s0f1:1'
NCCL_IB_GID_INDEX=3
CONTAINER_PREFIX=altar
MASTER_PORT=29823
API_BIND=127.0.0.1
API_PORT=8025
# Total input + output limit per request.
# Check the KV allocation and host memory headroom before changing these values.
MAX_MODEL_LEN=327680
KV_CACHE_BYTES=18253611008
MAX_NUM_SEQS=4
MAX_BATCHED_TOKENS=8192
GPU_MEMORY_UTILIZATION=0.80

# Enable prefix caching after checking behavior on your hosts.
PREFIX_CACHING=1
DCP_SIZE=4
NCCL_CHANNELS=8
CUDA_GRAPH_MODE=none

# This recipe uses FP8 KV cache.
KV_CACHE_DTYPE=fp8

# Build the root Dockerfile; the launcher checks its image labels and geometry.
EXPERIMENTAL_DSA_CKV_GATHER=1
FLASHINFER_AUTOTUNE=1

# Enable the mixed prefill/decode path in this example.
# The launcher and backend default off when this setting is absent.
EXPERIMENTAL_DSA_CKV_MIXED=1
