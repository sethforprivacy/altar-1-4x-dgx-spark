+def _altar_dsa_ckv_requested(hf_config: object, cache_dtype: str) -> bool:
+    """Opt in to the experimental full-GLM FP8 cached-KV prefill path."""
+    if os.environ.get("ALTAR_ENABLE_DSA_CKV_GATHER", "0") != "1":
+        return False
+    if not _is_glm_dsa_config(hf_config):
+        return False
+    if cache_dtype not in ("fp8", "fp8_ds_mla"):
+        raise ValueError("Experimental GLM DSA CKV gather requires FP8 KV")
+    expected = {"kv_lora_rank": 512, "qk_rope_head_dim": 64,
+                "index_topk": 2048, "num_attention_heads": 64}
+    for name, value in expected.items():
+        if getattr(hf_config, name, None) != value:
+            raise ValueError(f"Experimental GLM DSA CKV gather requires {name}={value}")
+    return True
+
